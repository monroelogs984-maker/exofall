size 32 32
// generated by gen_weapon_px.py from serrated_longsword_ids.png; hand touches in serrated_longsword.fix
gradramp wrap 8 #0e1a0e #1c3018 #2c4822 #3e602c
gradramp gold 12 #3c2406 #7c4c0e #c08418 #eeb434 #ffe07a #fff8d8
gradramp edge 12 #2a3434 #4a5854 #6e7e78 #9aaaa2 #c6d4cc #eef8f2
gradramp claw 12 #0e2a0e #1c4418 #2e6622 #46882c #68aa36 #98cc56 #d0ec96
gradramp tooth 10 #1c4418 #46882c #68aa36 #98cc56 #d0ec96
gradramp emerald 8 #06301a #0c5a2c #14904a #2ec46c #7cf0a8 #d0ffe2
layer outline
layer ids
import serrated_longsword_ids.png 0 0
layer wrap
take ids #00FFFF
shade wrap contrast=0.5 depth=1
layer gold
take ids #FFFF00
shade gold contrast=0.7 depth=1
layer edge
take ids #00FF00
shade edge contrast=0.5 depth=1 grad=0,31,31,0,0.35
layer claw
take ids #FF0000
shade claw contrast=0.6 depth=2 grad=0,31,31,0,0.35
layer tooth
take ids #FF00FF
shade tooth contrast=0.6 depth=1
layer emerald
take ids #0000FF
shade emerald contrast=0.9 depth=1
layer outline
copy wrap
copy gold
copy edge
copy claw
copy tooth
copy emerald
outline #0c1e0c outer
