size 32 32
// generated by gen_weapon_px.py from royal_grandhammer_ids.png; hand touches in royal_grandhammer.fix
gradramp wood 10 #1c120e #34221a #4e3424 #6c4a30 #8a6440
gradramp wrap 10 #1e0f0a #3c2014 #5e3620 #7e4e2e
gradramp hgold 12 #3a1804 #6e3806 #a85e0e #d8901e #f4be48
gradramp gold 12 #3c2406 #7c4c0e #c08418 #eeb434 #ffe07a #fff8d8
gradramp face 12 #3c2406 #7c4c0e #c08418 #eeb434 #ffe07a #fff8d8
