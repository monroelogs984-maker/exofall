gradramp amber 8 #3a1804 #7a3a06 #c06810 #f09a20 #ffcc60
gradramp drip 8 #3a1804 #7a3a06 #c06810 #f09a20 #ffcc60
layer outline
layer ids
import royal_grandhammer_ids.png 0 0
layer wood
take ids #FF8000
shade wood contrast=0.5 depth=1
layer wrap
take ids #8000FF
shade wrap contrast=0.5 depth=1
layer hgold
take ids #00FFFF
shade hgold contrast=0.5 depth=2 grad=31,31,0,0,0.3
layer gold
take ids #FF00FF
shade gold contrast=0.7 depth=1
layer face
take ids #FFFF00
shade face contrast=0.7 depth=1
layer comb
take ids #00FF00
shade comb contrast=0.3 depth=1
layer amber
take ids #FF0000
shade amber contrast=0.8 depth=1
layer drip
take ids #0000FF
shade drip contrast=0.6 depth=1
layer outline
copy wood
copy wrap
copy hgold
copy gold
copy face
copy comb
copy amber
copy drip
outline #2e1404 outer
