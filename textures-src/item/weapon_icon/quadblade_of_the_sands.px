size 32 32
// generated by gen_weapon_px.py from quadblade_of_the_sands_ids.png; hand touches in quadblade_of_the_sands.fix
gradramp wrap 12 #1e0f0a #3c2014 #5e3620 #7e4e2e
gradramp bronze 12 #2a1006 #6a3410 #a85c1c #d88a2c #f0b450
gradramp blade 12 #3a1a08 #8a4a18 #c87c2c #eab058 #ffd88a #fff4d0
gradramp gold 12 #3c2406 #7c4c0e #c08418 #eeb434 #ffe07a #fff8d8
gradramp turq 8 #072e34 #0e5c62 #1c9892 #40d0c0 #a8fff0
layer outline
layer ids
import quadblade_of_the_sands_ids.png 0 0
layer wrap
take ids #FF00FF
shade wrap contrast=0.5 depth=1
layer bronze
take ids #00FF00
shade bronze contrast=0.7 depth=2
layer blade
take ids #FF0000
shade blade contrast=0.6 depth=1 grad=0,31,31,0,0.35
layer gold
take ids #0000FF
shade gold contrast=0.7 depth=1
layer turq
take ids #FFFF00
shade turq contrast=0.8 depth=1
layer outline
copy wrap
copy bronze
copy blade
copy gold
copy turq
outline #2a1208 outer
