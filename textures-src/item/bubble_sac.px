size 16 16
// Bubble Sac (Divebell Beetle drop): silvery air bubble in an olive-brown membrane sac, tied at the top.
gradramp bub 10 #2e4a5c #557a8e #8fb6c8 #c8e6f0 #f4fdff
gradramp mem 8 #33290f #574a22 #7a6c34 #a8995a
layer bubble
key B #8fb6c8
grid 0 0
................
................
................
................
......BBBB......
....BBBBBBBB....
...BBBBBBBBBB...
..BBBBBBBBBBBB..
..BBBBBBBBBBBB..
..BBBBBBBBBBBB..
..BBBBBBBBBBBB..
..BBBBBBBBBBBB..
..BBBBBBBBBBBB..
...BBBBBBBBBB...
....BBBBBBBB....
................
end
shade bub light=-1,-1 depth=3 contrast=0.4 base=0.5
// darker inside rim where the membrane wraps it, so the bubble reads as a sphere inside a sac
outline bub.2 inner
// glints: sharp top-left highlight, refracted crescent bottom-right
px 4 6 bub.9
px 5 6 bub.9
px 4 7 bub.9
px 6 5 bub.8
px 11 11 bub.8
px 11 10 bub.7
px 10 12 bub.7
layer membrane
key M #7a6c34
key K #574a22
grid 0 0
................
......KKK.......
.......KK.......
.......MM.......
......MMMM......
.....M....M.....
................
................
................
................
..M..........M..
..M..........M..
..MM........MM..
...MMM....MMM...
....MMMMMMMM....
................
end
shade mem light=-1,-1 depth=1 contrast=0.3 grad=12,14,3,1,0.35 base=0.45
px 6 1 mem.7
px 7 3 mem.6
