size 16 16
// Lethal Proboscis: the Terror of the Bog's piercing beak. A straight olive-brown spike in ringed segments,
// thick at the torn base and needle-sharp at the tip.
gradramp beak 10 #1a1a08 #343416 #5a5e26 #868e3a #b2ba5e #e4e8a4
layer beak
key X #927a40
grid 0 0
...............X
..............X.
.............XX.
............XX..
...........XXX..
..........XXX...
.........XXXX...
........XXXX....
.......XXXXX....
......XXXXX.....
.....XXXXXX.....
....XXXXXX......
...XXXXXXX......
..XXXXXXX.......
..XXXXXX........
...XXXX.........
end
shade beak light=-1,-1 depth=2 contrast=0.6 grad=2,14,14,1,0.25 base=0.5
outline beak.0 inner
// segment rings: dark seams across the spike
line 7 8 10 11 beak.1
line 4 11 7 14 beak.1
line 10 5 12 7 beak.1
layer tip
px 15 0 #ffffff
px 14 1 #e4e8a4
layer stump
key Y #343416
grid 0 0
................
................
................
................
................
................
................
................
................
................
................
................
................
..Y.............
..Y.............
...YY...........
end
