size 32 32
// generated by gen_baubles.py; edit there
gradramp leaf 10 #0c2a0e #1a4a16 #2e7020 #4e9a2c #84c450 #c8ec90
gradramp vein 6 #a8d060 #d4f098
gradramp rib 6 #1a3a10 #2e5a18
gradramp mand 10 #2a1004 #5a2a08 #9a5212 #d8862a #ffc870
gradramp head 8 #1a0c06 #3a1e0e #6a3a1a #9a5a2a
gradramp cord 6 #2a1a0c #5a3a1a #8a6030
layer outline
layer base
key f #11C800
key w #28B73D
key v #3FA67A
key m #5695B7
key h #6D84F4
key c #847331
grid 0 0
