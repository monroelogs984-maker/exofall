layer m_f
take base #11C800
shade leaf contrast=0.5 depth=4
layer m_w
take base #28B73D
shade vein contrast=0.2 depth=1
layer m_v
take base #3FA67A
shade vein contrast=0.3 depth=1
layer m_m
take base #5695B7
shade mand contrast=0.7 depth=1
layer m_h
take base #6D84F4
shade head contrast=0.6 depth=2
layer m_c
take base #847331
shade cord contrast=0.4 depth=1
layer outline
