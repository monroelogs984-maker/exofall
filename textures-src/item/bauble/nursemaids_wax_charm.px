end
layer m_w
take base #11C800
shade wax contrast=0.6 depth=2
layer m_i
take base #28B73D
shade comb contrast=0.3 depth=1
layer m_h
take base #3FA67A
shade honey contrast=0.7 depth=2
layer m_c
take base #5695B7
shade chain contrast=0.3 depth=1
layer outline
copy m_w
copy m_i
copy m_h
copy m_c
outline #2e2010 outer
