size 32 32
// generated by gen_baubles.py; edit there
gradramp wax 10 #6a5030 #b09a6a #e0d0a8 #f6ecd2 #fffaf0
gradramp comb 8 #8e641c #bc8e30 #e0b850 #f8dc88
gradramp honey 8 #6a2a04 #b05a08 #e88a14 #ffb830 #ffe080
gradramp chain 6 #3a2a14 #6a5030 #a08860
layer outline
layer base
key w #11C800
key i #28B73D
key h #3FA67A
key c #5695B7
grid 0 0
