size 16 16
// Shellrock Crafting Table top: a 5x5 grid of polished chitin cells in dark seams, framed by a pearl Shellrock rim.
gradramp cell 8 #3e2a1a #5e432a #82603e #a3825a #c4a47a
gradramp seam 4 #24170e #36241a #4a3424
gradramp pearl 8 #8c8ca6 #b4b0c8 #d8d2e4 #f0ecf4 #ffffff
layer cells
import /home/glenn/mc-modding/mod-dev/exofall-1211/src/main/resources/assets/exofall/textures/block/polished_chitinstone.png 0 0
remap cell
layer seams
key s #36241a
grid 0 0
................
